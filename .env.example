# NextAuth / Auth.js Configuration
AUTH_SECRET="generate-a-secure-random-32-byte-hex-secret-here"
AUTH_URL="http://localhost:3000"

# GitHub OAuth / GitHub App Credentials
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# GitHub App Integration (Optional for App Mode vs OAuth Mode)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# PostgreSQL with pgvector (Supabase or Neon Free Tier)
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# Google Gemini API ($0 Free Tier on Google AI Studio)
GEMINI_API_KEY="AIzaSy..."

# Cloudflare R2 ($0 S3-Compatible Storage, 10GB free, $0 egress)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="codeguard-artifacts"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Token Encryption Secret (32-character hex key for AES-256-GCM)
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
